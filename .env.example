# Database
DATABASE_URL=postgresql://agromind:agromind@localhost:5432/agromind

# Hugging Face
HF_API_KEY=your_hf_api_key_here
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Weather API (Kenya Met Department or OpenWeather)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Market API (Kenya Agricultural Market)
MARKET_API_URL=https://api.kamis.co.ke/v1
MARKET_API_KEY=your_market_api_key_here

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Languages
DEFAULT_LANGUAGE=sw
SUPPORTED_LANGUAGES=en,sw